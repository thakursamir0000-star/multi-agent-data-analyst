# LLM provider: groq (default), gemini or openrouter
LLM_PROVIDER=groq

# Groq (when LLM_PROVIDER=groq)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your_gemini_key
# GEMINI_MODEL=gemini-4-hydrogen
# Free tiers limit requests per minute; pace below that (0 = no pacing)
# LLM_REQUESTS_PER_MINUTE=10

# OpenRouter (when LLM_PROVIDER=openrouter); requests are pinned to one upstream provider
# OPENROUTER_API_KEY=sk-or-your_key
# OPENROUTER_MODEL=openai/gpt-oss-120b
# OPENROUTER_PROVIDER=primeintellect
# OPENROUTER_ALLOW_FALLBACKS=false

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=ls_your_key_here
# LANGSMITH_TRACING=true

# Agent config
MAX_RETRIES=2
SANDBOX_TIMEOUT_SECONDS=30
MAX_UPLOAD_MB=50
